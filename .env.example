# Public configuration template only: never put credentials in this file.
# Copy to .env; keep real values in ignored local files or a deployment secret store.
# See README.md for cloud setup and docs/production-readiness-plan.md before deployment.

# Application and admin publication. Blank token disables protected admin operations.
APP_MODE=local
ADMIN_TOKEN=

# Chat model. This model/location must be available in your Google Cloud project.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
GEMINI_USE_VERTEXAI=true
GEMINI_THINKING_LEVEL=medium
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Absolute service-account JSON path (forward slashes work on Windows), or blank for ADC.
# Prefer a managed workload identity in a production deployment.
GOOGLE_APPLICATION_CREDENTIALS=

# Google embeddings: shared by company documents and catalog discovery.
# Legacy Weaviate collections require explicit migration; see docs/setup.md.
GOOGLE_EMBEDDING_LOCATION=us-central1
EMBEDDING_PROVIDER=vertex
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Neo4j application connection. Use your instance's actual database name.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Absolute installed neo4j-mcp-server executable path; backend configures read-only tools.
NEO4J_MCP_COMMAND=
NEO4J_MCP_ARGS=[]

# Weaviate Cloud document store and named vector.
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=CompanyChunk
WEAVIATE_VECTOR_NAME=google_1536
COMPANY_DOMAIN=attoforce.ai

# Process-local conversation bounds, not production quotas or a persistence policy.
MEMORY_TOKEN_LIMIT=6000
MEMORY_KEEP_MESSAGES=6
AGENT_RECURSION_LIMIT=16

# Optional observability. Content capture stays off unless explicitly approved.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_ENVIRONMENT=development

# Single-host state; back up the document manifest, not into Git.
# Resolve these paths from the repository root, or use deployment-specific absolute paths.
CATALOG_PATH=data/runtime/catalog.json
KNOWLEDGE_PATH=data/runtime/knowledge.json
