APP_MODE=local
ADMIN_TOKEN=replace-with-a-long-random-local-token
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
GEMINI_USE_VERTEXAI=true
GEMINI_THINKING_LEVEL=medium
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_EMBEDDING_LOCATION=us-central1
# Local service-account JSON path, or leave blank to use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# For an existing Snowflake index, run migrate-embeddings before switching to vertex.
EMBEDDING_PROVIDER=vertex
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
WEAVIATE_VECTOR_NAME=google_1536
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=CompanyChunk
COMPANY_DOMAIN=attoforce.ai
NEO4J_MCP_COMMAND=
NEO4J_MCP_ARGS=[]

MEMORY_TOKEN_LIMIT=6000
MEMORY_KEEP_MESSAGES=6
AGENT_RECURSION_LIMIT=16
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_ENVIRONMENT=development
