# Normalize text in Git while leaving binary content untouched.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.svg text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
